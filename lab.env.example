# =============================================================================
#  Configuration du laboratoire / Configuración del laboratorio
#  Copier en lab.env puis adapter :   cp lab.env.example lab.env
#  Copiar a lab.env y adaptar :       cp lab.env.example lab.env
# =============================================================================

# --- Hôte Proxmox VE / Host Proxmox VE --------------------------------------
PVE_NODE="pve"                 # nom du nœud (hostname) / nombre del nodo
PVE_STORAGE="local-lvm"        # stockage des disques VM / almacenamiento de discos
PVE_ISO_STORAGE="local"        # stockage des ISO / almacenamiento de ISOs
BRIDGE_MGMT="vmbr0"            # LAN : gestion ESXi / LAN: gestión de ESXi
BRIDGE_LAB="vmbr1"             # réseau isolé (OPNsense) / red aislada (OPNsense)

# --- VM ESXi imbriqué / VM ESXi anidado --------------------------------------
ESXI_VMID="900"
ESXI_NAME="esxi8-lab"
ESXI_ISO="VMware-VMvisor-Installer-8.0U3e-24674464.x86_64.iso"  # nom exact du fichier ISO
ESXI_CORES="4"
ESXI_MEMORY_MB="16384"         # 16 Go : laisse ~14 Go à l'hôte et aux VM migrées
ESXI_DISK_GB="200"             # disque unique (thin) : système + datastore1
ESXI_IP="192.168.1.50"
ESXI_NETMASK="255.255.255.0"
ESXI_GATEWAY="192.168.1.1"
ESXI_DNS="1.1.1.1"
ESXI_HOSTNAME="esxi8-lab.lab.local"

# --- Import (stockage "esxi" de Proxmox) -------------------------------------
ESXI_STORAGE_ID="esxi-lab"
ESXI_USER="root"
# Ne jamais committer le mot de passe / Nunca subir la contraseña al repo
ESXI_PASSWORD=""

# --- Pilotes VirtIO / Drivers VirtIO ------------------------------------------
VIRTIO_ISO="virtio-win.iso"
